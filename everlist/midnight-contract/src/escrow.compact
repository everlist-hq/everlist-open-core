/**
 * EverList Booking Escrow - funded state machine (M3 increment)
 *
 * The booking escrow lifecycle the EverList hub already uses, now with REAL
 * (simulated) shielded money:
 *   HELD (1)    -> RELEASED (2)  organizer confirmed -> organizer paid
 *   HELD (1)    -> REFUNDED (3)  agent cancelled / timeout -> agent refunded
 *
 * Parties are privacy-preserving: each side ACTS via a commitment
 * (persistentHash of a secret key), never an address. Money moves via coin
 * public keys stored in two ledger maps (ZswapCoinPublicKey) — payout
 * destinations are fixed at creation, so even the permissionless timeout
 * cannot redirect funds.
 *
 * Coin flows (M3):
 *   createEscrow  : agent deposits EXACTLY `amount` into the contract
 *                   (receiveShielded; deposit.value == amount asserted)
 *   releaseEscrow : contract spends the deposited coin -> organizer
 *   refundEscrow  : contract spends the deposited coin -> agent
 *   timeoutRefund : anyone (liveness) spends the deposited coin -> agent
 *                   after the deadline (before the claim deadline)
 *   autoRelease   : anyone (M17) spends the deposited coin -> organizer
 *                   after the CLAIM deadline passes with no refund claim
 *
 * The spender supplies the coin as a QualifiedShieldedCoinInfo (in real
 * deployments this carries the merkle membership witness); the contract
 * asserts it matches the stored custody (nonce, color, value).
 *
 * Disclosure discipline: disclose() at ledger writes and stdlib calls that
 * need public values; witness->hash->assert comparisons need none.
 *
 * Language: Compact 0.26 (compiler 0.34.0)
 */

pragma language_version 0.26;
// M12 (pending owner decision, recommendation = A): pilot contract, NO
// upgrade path assumed - effective immutability. Liveness guarantee =
// timeoutRefund (permissionless, pays the agent key fixed at creation).
// Never hold mainnet-size funds here until the upgrade decision is made.

import CompactStandardLibrary;

struct Escrow {
  amount: Uint<128>,
  agentCommitment: Bytes<32>,
  organizerCommitment: Bytes<32>,
  state: Uint<8>,
  bookingRef: Bytes<32>,
  deadline: Uint<64>,
  claimDeadline: Uint<64>,
  coinNonce: Bytes<32>,
  coinColor: Bytes<32>
}

export ledger escrows: Map<Uint<64>, Escrow>;
export ledger nextId: Counter;
export ledger agentPks: Map<Uint<64>, ZswapCoinPublicKey>;
export ledger organizerPks: Map<Uint<64>, ZswapCoinPublicKey>;
// W3.1 dispute path: per-escrow arbiter record. LIVES SEPARATELY from the
// Escrow struct so pre-dispute escrows (and the hub's fixture codec) are
// untouched; absent = dispute rail not armed for that escrow.
struct Arbiter {
  commitment: Bytes<32>,
  deadline: Uint<64>
}
export ledger arbiters: Map<Uint<64>, Arbiter>;

witness agentSecretKey(): Bytes<32>;
witness organizerSecretKey(): Bytes<32>;
witness arbiterSecretKey(): Bytes<32>; // W3.1: never leaves the arbiter's machine

/**
 * Commitment of an agent (buyer). sk never leaves the agent's machine.
 * W2 privacy fix (Tell scan 2026-10-16, medium finding): the tag is now
 * bound to the bookingRef, so one holder's escrows no longer line up on
 * the public ledger — identifying one booking does not identify the
 * holder's other bookings (per-booking tag, Tell's suggested fix).
 */
export circuit agentCommitment(sk: Bytes<32>, bookingRef: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "everlist:agent:"), sk, bookingRef]);
}

/**
 * Commitment of an organizer (seller). sk never leaves their machine.
 * W2 privacy fix: same per-booking binding as the agent tag.
 */
export circuit organizerCommitment(sk: Bytes<32>, bookingRef: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "everlist:organizer:"), sk, bookingRef]);
}

/**
 * Arbiter commitment (W3.1 dispute path), bound to the booking like the
 * party tags (W2 Tell fix pattern) — no cross-escrow linkage.
 */
export circuit arbiterCommitment(sk: Bytes<32>, bookingRef: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "everlist:arbiter:"), sk, bookingRef]);
}

/**
 * Agent opens AND FUNDS an escrow. The deposit coin must equal the escrow
 * amount exactly; it becomes contract custody via receiveShielded.
 */
export circuit createEscrow(
  amount: Uint<128>,
  organizerCommitmentInput: Bytes<32>,
  bookingRef: Bytes<32>,
  deadline: Uint<64>,
  claimDeadline: Uint<64>,
  deposit: ShieldedCoinInfo,
  agentPk: ZswapCoinPublicKey,
  organizerPk: ZswapCoinPublicKey
): [] {
  assert(amount > 0, "amount must be positive");
  assert(deposit.value == amount, "deposit must equal escrow amount");
  assert(claimDeadline > deadline, "claim deadline must be after refund deadline");
  receiveShielded(disclose(deposit));

  nextId.increment(1);
  const id = disclose(nextId.read() as Uint<64>);
  const aComm = agentCommitment(agentSecretKey(), bookingRef);

  escrows.insert(id, Escrow {
    amount: disclose(amount),
    agentCommitment: disclose(aComm),
    organizerCommitment: disclose(organizerCommitmentInput),
    state: 1, // HELD
    bookingRef: disclose(bookingRef),
    deadline: disclose(deadline),
    claimDeadline: disclose(claimDeadline),
    coinNonce: disclose(deposit.nonce),
    coinColor: disclose(deposit.color)
  });
  agentPks.insert(id, disclose(agentPk));
  organizerPks.insert(id, disclose(organizerPk));
}

/**
 * Organizer releases the funds (service confirmed): the deposited coin is
 * spent to the organizer's stored coin public key. Only the organizer
 * (commitment match) and only while HELD.
 */
export circuit releaseEscrow(escrowId: Uint<64>, spendCoin: QualifiedShieldedCoinInfo): [] {
  const id = disclose(escrowId);
  assert(escrows.member(id), "escrow not found");
  const e = escrows.lookup(id);
  assert(e.state == 1, "escrow not in HELD state"); // HELD
  const caller = organizerCommitment(organizerSecretKey(), e.bookingRef);
  assert(caller == e.organizerCommitment, "only organizer can release");
  assert(spendCoin.nonce == e.coinNonce, "coin does not match escrow custody");
  assert(spendCoin.color == e.coinColor, "coin does not match escrow custody");
  assert(spendCoin.value == e.amount, "coin does not match escrow custody");

  sendShielded(
    disclose(spendCoin),
    left<ZswapCoinPublicKey, ContractAddress>(organizerPks.lookup(id)),
    e.amount
  );

  escrows.insert(id, Escrow {
    amount: e.amount,
    agentCommitment: e.agentCommitment,
    organizerCommitment: e.organizerCommitment,
    state: 2, // RELEASED
    bookingRef: e.bookingRef,
    deadline: e.deadline,
    claimDeadline: e.claimDeadline,
    coinNonce: e.coinNonce,
    coinColor: e.coinColor
  });
}

/**
 * Agent takes the refund (cancellation before service): the deposited coin
 * returns to the agent's stored coin public key. Only the agent and only
 * while HELD.
 */
export circuit refundEscrow(escrowId: Uint<64>, spendCoin: QualifiedShieldedCoinInfo): [] {
  const id = disclose(escrowId);
  assert(escrows.member(id), "escrow not found");
  const e = escrows.lookup(id);
  assert(e.state == 1, "escrow not in HELD state"); // HELD
  const caller = agentCommitment(agentSecretKey(), e.bookingRef);
  assert(caller == e.agentCommitment, "only agent can refund");
  assert(!(blockTimeGte(e.claimDeadline)), "claim deadline passed - merchant auto-release applies");
  assert(spendCoin.nonce == e.coinNonce, "coin does not match escrow custody");
  assert(spendCoin.color == e.coinColor, "coin does not match escrow custody");
  assert(spendCoin.value == e.amount, "coin does not match escrow custody");

  sendShielded(
    disclose(spendCoin),
    left<ZswapCoinPublicKey, ContractAddress>(agentPks.lookup(id)),
    e.amount
  );

  escrows.insert(id, Escrow {
    amount: e.amount,
    agentCommitment: e.agentCommitment,
    organizerCommitment: e.organizerCommitment,
    state: 3, // REFUNDED
    bookingRef: e.bookingRef,
    deadline: e.deadline,
    claimDeadline: e.claimDeadline,
    coinNonce: e.coinNonce,
    coinColor: e.coinColor
  });
}

/**
 * Permissionless timeout refund (liveness): once the deadline has passed,
 * ANYONE may return the deposit — to the AGENT'S STORED KEY, which the
 * caller cannot choose. The agent never loses funds to a silent organizer.
 */
export circuit timeoutRefund(escrowId: Uint<64>, spendCoin: QualifiedShieldedCoinInfo): [] {
  const id = disclose(escrowId);
  assert(escrows.member(id), "escrow not found");
  const e = escrows.lookup(id);
  assert(e.state == 1, "escrow not in HELD state"); // HELD
  assert(blockTimeGte(e.deadline), "deadline not reached yet");
  assert(!(blockTimeGte(e.claimDeadline)), "claim deadline passed - merchant auto-release applies");
  assert(spendCoin.nonce == e.coinNonce, "coin does not match escrow custody");
  assert(spendCoin.color == e.coinColor, "coin does not match escrow custody");
  assert(spendCoin.value == e.amount, "coin does not match escrow custody");

  sendShielded(
    disclose(spendCoin),
    left<ZswapCoinPublicKey, ContractAddress>(agentPks.lookup(id)),
    e.amount
  );

  escrows.insert(id, Escrow {
    amount: e.amount,
    agentCommitment: e.agentCommitment,
    organizerCommitment: e.organizerCommitment,
    state: 3, // REFUNDED
    bookingRef: e.bookingRef,
    deadline: e.deadline,
    claimDeadline: e.claimDeadline,
    coinNonce: e.coinNonce,
    coinColor: e.coinColor
  });
}

/**
 * M16 — Mutual refund after settlement (both parties consent).
 *
 * After RELEASED the original deposit coin is gone (spent to the organizer
 * by releaseEscrow), so the organizer returns equivalent funds THROUGH the
 * contract: this circuit receives the organizer's return coin and routes it
 * atomically to the agent's stored coin public key. BOTH commitments must
 * prove — neither party alone can move settled funds (one stolen key is
 * useless), and the payout destination is the agent key fixed at creation,
 * so the caller cannot redirect the refund.
 *
 * Equivalent-funds rule: the return coin must match the escrow's color and
 * exact amount; its nonce is intentionally NOT compared (it is a fresh
 * coin — the deposit coin no longer exists).
 */
export circuit mutualRefund(escrowId: Uint<64>, returnCoin: QualifiedShieldedCoinInfo): [] {
  const id = disclose(escrowId);
  assert(escrows.member(id), "escrow not found");
  const e = escrows.lookup(id);
  assert(e.state == 2, "escrow not in RELEASED state"); // RELEASED
  const callerAgent = agentCommitment(agentSecretKey(), e.bookingRef);
  assert(callerAgent == e.agentCommitment, "agent consent missing");
  const callerOrg = organizerCommitment(organizerSecretKey(), e.bookingRef);
  assert(callerOrg == e.organizerCommitment, "organizer consent missing");
  assert(returnCoin.color == e.coinColor, "return coin wrong asset");
  assert(returnCoin.value == e.amount, "return coin wrong amount");

  receiveShielded(disclose(ShieldedCoinInfo {
    nonce: returnCoin.nonce,
    color: returnCoin.color,
    value: returnCoin.value
  }));
  sendShielded(
    disclose(returnCoin),
    left<ZswapCoinPublicKey, ContractAddress>(agentPks.lookup(id)),
    e.amount
  );

  escrows.insert(id, Escrow {
    amount: e.amount,
    agentCommitment: e.agentCommitment,
    organizerCommitment: e.organizerCommitment,
    state: 3, // REFUNDED
    bookingRef: e.bookingRef,
    deadline: e.deadline,
    claimDeadline: e.claimDeadline,
    coinNonce: e.coinNonce,
    coinColor: e.coinColor
  });
}

/**
 * M17 — Merchant auto-release after a quiet claim deadline (liveness for
 * the seller side). Once the claim deadline has passed with no refund
 * claimed, ANYONE may spend the deposited coin to the ORGANIZER'S STORED
 * key — the caller cannot redirect it. This closes the bad-faith-buyer
 * gap: a buyer who received the service can no longer claw back forever.
 * Guard ordering: before the claim deadline the buyer-favoring
 * timeoutRefund applies; after it, autoRelease applies.
 */
export circuit autoRelease(escrowId: Uint<64>, spendCoin: QualifiedShieldedCoinInfo): [] {
  const id = disclose(escrowId);
  assert(escrows.member(id), "escrow not found");
  const e = escrows.lookup(id);
  assert(e.state == 1, "escrow not in HELD state"); // HELD
  assert(blockTimeGte(e.claimDeadline), "claim deadline not reached yet");
  assert(spendCoin.nonce == e.coinNonce, "coin does not match escrow custody");
  assert(spendCoin.color == e.coinColor, "coin does not match escrow custody");
  assert(spendCoin.value == e.amount, "coin does not match escrow custody");

  sendShielded(
    disclose(spendCoin),
    left<ZswapCoinPublicKey, ContractAddress>(organizerPks.lookup(id)),
    e.amount
  );

  escrows.insert(id, Escrow {
    amount: e.amount,
    agentCommitment: e.agentCommitment,
    organizerCommitment: e.organizerCommitment,
    state: 2, // RELEASED
    bookingRef: e.bookingRef,
    deadline: e.deadline,
    claimDeadline: e.claimDeadline,
    coinNonce: e.coinNonce,
    coinColor: e.coinColor
  });
}

/**
 * W3.1 — DISPUTE PATH (P2 #5, milestone.compact pattern ported).
 *
 * States: 4 = DISPUTED (frozen, only the arbiter or the timeout hatch
 * moves funds), 5 = ARB_RELEASED (final), 6 = ARB_REFUNDED (final).
 *
 * The arbiter is fixed per-escrow via setArbiter (agent-only, once, while
 * HELD, BEFORE any dispute): commitment + deadline land on-chain. Pilot:
 * the hub operates the arbiter key; the mechanism itself is trustless —
 * a vanished arbiter can never freeze funds (arbiterTimeoutRefund).
 *
 * While DISPUTED, release/refund/timeout/autoRelease all stay blocked
 * (they assert state == 1) — the freeze is structural, not a convention.
 */
export circuit setArbiter(
  escrowId: Uint<64>,
  arbiterCommitmentInput: Bytes<32>,
  arbiterDeadline: Uint<64>
): [] {
  const id = disclose(escrowId);
  assert(escrows.member(id), "escrow not found");
  const e = escrows.lookup(id);
  assert(e.state == 1, "escrow not in HELD state");
  assert(!(arbiters.member(id)), "arbiter already set");
  const caller = agentCommitment(agentSecretKey(), e.bookingRef);
  assert(caller == e.agentCommitment, "only agent can set the arbiter");
  assert(arbiterDeadline > e.claimDeadline, "arbiter deadline must be after claim deadline");

  arbiters.insert(id, Arbiter {
    commitment: disclose(arbiterCommitmentInput),
    deadline: disclose(arbiterDeadline)
  });
}

/** Agent freezes the escrow for arbitration (HELD -> DISPUTED). */
export circuit agentOpenDispute(escrowId: Uint<64>): [] {
  const id = disclose(escrowId);
  assert(escrows.member(id), "escrow not found");
  const e = escrows.lookup(id);
  assert(e.state == 1, "escrow not in HELD state");
  assert(arbiters.member(id), "no arbiter set for this escrow");
  const caller = agentCommitment(agentSecretKey(), e.bookingRef);
  assert(caller == e.agentCommitment, "only agent can open this dispute");

  escrows.insert(id, Escrow {
    amount: e.amount,
    agentCommitment: e.agentCommitment,
    organizerCommitment: e.organizerCommitment,
    state: 4, // DISPUTED
    bookingRef: e.bookingRef,
    deadline: e.deadline,
    claimDeadline: e.claimDeadline,
    coinNonce: e.coinNonce,
    coinColor: e.coinColor
  });
}

/** Organizer freezes the escrow for arbitration (HELD -> DISPUTED). */
export circuit organizerOpenDispute(escrowId: Uint<64>): [] {
  const id = disclose(escrowId);
  assert(escrows.member(id), "escrow not found");
  const e = escrows.lookup(id);
  assert(e.state == 1, "escrow not in HELD state");
  assert(arbiters.member(id), "no arbiter set for this escrow");
  const caller = organizerCommitment(organizerSecretKey(), e.bookingRef);
  assert(caller == e.organizerCommitment, "only organizer can open this dispute");

  escrows.insert(id, Escrow {
    amount: e.amount,
    agentCommitment: e.agentCommitment,
    organizerCommitment: e.organizerCommitment,
    state: 4, // DISPUTED
    bookingRef: e.bookingRef,
    deadline: e.deadline,
    claimDeadline: e.claimDeadline,
    coinNonce: e.coinNonce,
    coinColor: e.coinColor
  });
}

/**
 * Arbiter rules for the organizer (DISPUTED -> ARB_RELEASED): custody
 * coin pays the organizer's stored key. Only the arbiter.
 */
export circuit arbiterRelease(escrowId: Uint<64>, spendCoin: QualifiedShieldedCoinInfo): [] {
  const id = disclose(escrowId);
  assert(escrows.member(id), "escrow not found");
  const e = escrows.lookup(id);
  assert(e.state == 4, "escrow not in DISPUTED state");
  assert(arbiters.member(id), "no arbiter set for this escrow");
  const a = arbiters.lookup(id);
  const caller = arbiterCommitment(arbiterSecretKey(), e.bookingRef);
  assert(caller == a.commitment, "only arbiter can rule");
  assert(spendCoin.nonce == e.coinNonce, "coin does not match escrow custody");
  assert(spendCoin.color == e.coinColor, "coin does not match escrow custody");
  assert(spendCoin.value == e.amount, "coin does not match escrow custody");

  sendShielded(
    disclose(spendCoin),
    left<ZswapCoinPublicKey, ContractAddress>(organizerPks.lookup(id)),
    e.amount
  );

  escrows.insert(id, Escrow {
    amount: e.amount,
    agentCommitment: e.agentCommitment,
    organizerCommitment: e.organizerCommitment,
    state: 5, // ARB_RELEASED
    bookingRef: e.bookingRef,
    deadline: e.deadline,
    claimDeadline: e.claimDeadline,
    coinNonce: e.coinNonce,
    coinColor: e.coinColor
  });
}

/**
 * Arbiter rules for the agent (DISPUTED -> ARB_REFUNDED): custody coin
 * pays the agent's stored key. Only the arbiter.
 */
export circuit arbiterRefund(escrowId: Uint<64>, spendCoin: QualifiedShieldedCoinInfo): [] {
  const id = disclose(escrowId);
  assert(escrows.member(id), "escrow not found");
  const e = escrows.lookup(id);
  assert(e.state == 4, "escrow not in DISPUTED state");
  assert(arbiters.member(id), "no arbiter set for this escrow");
  const a = arbiters.lookup(id);
  const caller = arbiterCommitment(arbiterSecretKey(), e.bookingRef);
  assert(caller == a.commitment, "only arbiter can rule");
  assert(spendCoin.nonce == e.coinNonce, "coin does not match escrow custody");
  assert(spendCoin.color == e.coinColor, "coin does not match escrow custody");
  assert(spendCoin.value == e.amount, "coin does not match escrow custody");

  sendShielded(
    disclose(spendCoin),
    left<ZswapCoinPublicKey, ContractAddress>(agentPks.lookup(id)),
    e.amount
  );

  escrows.insert(id, Escrow {
    amount: e.amount,
    agentCommitment: e.agentCommitment,
    organizerCommitment: e.organizerCommitment,
    state: 6, // ARB_REFUNDED
    bookingRef: e.bookingRef,
    deadline: e.deadline,
    claimDeadline: e.claimDeadline,
    coinNonce: e.coinNonce,
    coinColor: e.coinColor
  });
}

/**
 * Arbiter-liveness hatch (never weaker than the base contract): a
 * DISPUTED escrow past the arbiter deadline can be refunded to the
 * agent's stored key by ANYONE — a vanished arbiter can never freeze
 * buyer funds forever. The organizer's remedy is a timely ruling.
 */
export circuit arbiterTimeoutRefund(escrowId: Uint<64>, spendCoin: QualifiedShieldedCoinInfo): [] {
  const id = disclose(escrowId);
  assert(escrows.member(id), "escrow not found");
  const e = escrows.lookup(id);
  assert(e.state == 4, "escrow not in DISPUTED state");
  assert(arbiters.member(id), "no arbiter set for this escrow");
  const a = arbiters.lookup(id);
  assert(blockTimeGte(a.deadline), "arbiter deadline not yet passed");
  assert(spendCoin.nonce == e.coinNonce, "coin does not match escrow custody");
  assert(spendCoin.color == e.coinColor, "coin does not match escrow custody");
  assert(spendCoin.value == e.amount, "coin does not match escrow custody");

  sendShielded(
    disclose(spendCoin),
    left<ZswapCoinPublicKey, ContractAddress>(agentPks.lookup(id)),
    e.amount
  );

  escrows.insert(id, Escrow {
    amount: e.amount,
    agentCommitment: e.agentCommitment,
    organizerCommitment: e.organizerCommitment,
    state: 6, // ARB_REFUNDED
    bookingRef: e.bookingRef,
    deadline: e.deadline,
    claimDeadline: e.claimDeadline,
    coinNonce: e.coinNonce,
    coinColor: e.coinColor
  });
}

/**
 * Public read helper: is this escrow still HELD?
 * (the hub polls this via the indexer to mirror on-chain state)
 */
export circuit isHeld(escrowId: Uint<64>): Boolean {
  const id = disclose(escrowId);
  assert(escrows.member(id), "escrow not found");
  const e = escrows.lookup(id);
  return e.state == 1; // HELD
}

/*
 * W3.3 batch settlement circuit (2026-10-20):
 * N escrows released in ONE circuit call = one proof/transaction instead of N.
 * Pilot N=2 to prove mechanics (multi-coin spend in a single circuit).
 * Walls: same organizer, both HELD, both custody match, both pass caller proof.
 */
export circuit batchRelease2(
  escrowId1: Uint<64>,
  escrowId2: Uint<64>,
  spendCoin1: QualifiedShieldedCoinInfo,
  spendCoin2: QualifiedShieldedCoinInfo
): [] {
  assert(escrowId1 != escrowId2, "escrow ids must differ");
  const id1 = disclose(escrowId1);
  assert(escrows.member(id1), "escrow 1 not found");
  const e1 = escrows.lookup(id1);
  assert(e1.state == 1, "escrow 1 not in HELD state");
  assert(spendCoin1.nonce == e1.coinNonce, "coin 1 does not match escrow custody");
  assert(spendCoin1.color == e1.coinColor, "coin 1 does not match escrow custody");
  assert(spendCoin1.value == e1.amount, "coin 1 does not match escrow custody");
  const id2 = disclose(escrowId2);
  assert(escrows.member(id2), "escrow 2 not found");
  const e2 = escrows.lookup(id2);
  assert(e2.state == 1, "escrow 2 not in HELD state");
  assert(spendCoin2.nonce == e2.coinNonce, "coin 2 does not match escrow custody");
  assert(spendCoin2.color == e2.coinColor, "coin 2 does not match escrow custody");
  assert(spendCoin2.value == e2.amount, "coin 2 does not match escrow custody");
  // SAME-ORGANIZER wall, privacy-preserving (per-booking commitments)
  const caller1 = organizerCommitment(organizerSecretKey(), e1.bookingRef);
  assert(caller1 == e1.organizerCommitment, "only organizer can release escrow 1");
  const caller2 = organizerCommitment(organizerSecretKey(), e2.bookingRef);
  assert(caller2 == e2.organizerCommitment, "only organizer can release escrow 2");
  sendShielded(disclose(spendCoin1), left<ZswapCoinPublicKey, ContractAddress>(organizerPks.lookup(id1)), e1.amount);
  sendShielded(disclose(spendCoin2), left<ZswapCoinPublicKey, ContractAddress>(organizerPks.lookup(id2)), e2.amount);
  escrows.insert(id1, Escrow {
    amount: e1.amount,
    agentCommitment: e1.agentCommitment,
    organizerCommitment: e1.organizerCommitment,
    state: 2, // RELEASED
    bookingRef: e1.bookingRef,
    deadline: e1.deadline,
    claimDeadline: e1.claimDeadline,
    coinNonce: e1.coinNonce,
    coinColor: e1.coinColor
  });
  escrows.insert(id2, Escrow {
    amount: e2.amount,
    agentCommitment: e2.agentCommitment,
    organizerCommitment: e2.organizerCommitment,
    state: 2, // RELEASED
    bookingRef: e2.bookingRef,
    deadline: e2.deadline,
    claimDeadline: e2.claimDeadline,
    coinNonce: e2.coinNonce,
    coinColor: e2.coinColor
  });
}
