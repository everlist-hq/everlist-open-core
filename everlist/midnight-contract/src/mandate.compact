/**
 * EverList Delegated Spending Mandate (techmining P1 #1, 2026-10-17)
 *
 * The human-principal -> agent trust layer (Grant/AgentPass pattern,
 * adapted to EverList bookings):
 *   A principal (human) issues a mandate: spending cap + allowed action
 *   category (PRIVATE terms, hidden in a commitment) with a public expiry
 *   deadline. The principal keeps the revocation secret; the agent holds
 *   the mandate secret + the private terms.
 *
 *   authorize() is the agent's ZK ACT: it proves, without revealing the
 *   private terms, that a proposed action (public amount, public
 *   category) is INSIDE them:
 *     - knowledge of the secret behind the stored action commitment
 *     - amount <= private cap
 *     - category == private allowed category
 *     - ledger block time < public expiry
 *     - mandate not revoked
 *   On success a public usage counter increments (principal accounting).
 *
 * Privacy model (honest, adapted from Grant's design for enforceability):
 *   - PRIVATE: the two secrets, the cap and the allowed category (the
 *     commercial terms). They never leave the parties' machines; only a
 *     hiding commitment touches the ledger.
 *   - PUBLIC BY DESIGN: expiry (enforceable deadline — same choice as our
 *     escrow deadlines; a hidden expiry cannot be checked against ledger
 *     block time without disclosing it, per compactc 0.34.0), the usage
 *     counter, and the ACTION's amount/category on each authorize call
 *     (verifiable stake, like escrow amounts).
 *   - Inherent bound: a FAILED authorize reveals amount > cap (the point
 *     of a cap — denials are observable, like any failed assertion); a
 *     successful one proves the mandate was valid at that block time.
 *   - Party identity is never revealed: commitments are per-mandate, not
 *     per-holder.
 *
 * Revocation is revoke-secret-only and permanent (one-way, like our
 * credential registry). A revoked mandate can never authorize again.
 *
 * Future (documented, not built): escrow.createEscrow accepting a mandate
 * proof directly; nullifier-style unlinkable authorizations.
 *
 * Language: Compact 0.26 (compiler 0.34.0)
 */

pragma language_version 0.26;

import CompactStandardLibrary;

struct Mandate {
  actionCommitment: Bytes<32>,
  revokeCommitment: Bytes<32>,
  expiry: Uint<64>,
  revoked: Boolean
}

export ledger mandates: Map<Uint<64>, Mandate>;
export ledger uses: Map<Uint<64>, Uint<64>>; // public usage counter
export ledger nextId: Counter;

witness mandateSecretKey(): Bytes<32>;   // held by the AGENT
witness mandateCap(): Uint<128>;         // private term: spending cap
witness mandateCategory(): Uint<8>;      // private term: allowed category
witness revokeSecretKey(): Bytes<32>;    // held by the PRINCIPAL

/**
 * The mandate's hiding commitment: binds the agent-held secret to the
 * PRIVATE terms (cap, category). Terms are hashed first (Uint vector),
 * then combined with the secret (prefix-separated domain). The public
 * expiry is deliberately NOT part of the commitment (it is stored in the
 * clear and enforced by ledger block time).
 */
export circuit mandateCommitment(
  sk: Bytes<32>,
  cap: Uint<128>,
  category: Uint<8>
): Bytes<32> {
  const terms = persistentHash<Vector<2, Uint<128>>>([
    category as Uint<128>,
    cap
  ]);
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "everlist:mandate:"), sk, terms]);
}

/** Revocation authority commitment. sk never leaves the principal. */
export circuit revokeCommitment(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "everlist:mandate:revoke:"), sk]);
}

/**
 * Principal publishes a mandate: stores the two commitments plus the
 * public expiry, returns the mandate id. Self-custodial — the commitments
 * ARE the authority; no issuer identity ever touches the ledger.
 */
export circuit issueMandate(actionComm: Bytes<32>, revokeComm: Bytes<32>, expiry: Uint<64>): Uint<64> {
  assert(expiry > 0, "expiry must be positive");
  nextId.increment(1);
  const id = disclose(nextId.read() as Uint<64>);
  mandates.insert(id, Mandate {
    actionCommitment: disclose(actionComm),
    revokeCommitment: disclose(revokeComm),
    expiry: disclose(expiry),
    revoked: false
  });
  uses.insert(id, 0);
  return id;
}

/**
 * The agent's ZK authorization act: proves the action (public amount,
 * public category) is INSIDE the private terms of the stored mandate —
 * knowledge of the secret, amount <= cap, category match, before the
 * public expiry, not revoked. Increments the public usage counter on
 * success. Ordering: the commitment wall is checked FIRST, so a caller
 * who does not know the true terms fails before anything else runs.
 */
export circuit authorize(mandateId: Uint<64>, amount: Uint<128>, actionCategory: Uint<8>): [] {
  const id = disclose(mandateId);
  assert(mandates.member(id), "mandate not found");
  const m = mandates.lookup(id);
  assert(!m.revoked, "mandate revoked");

  // recompute the commitment from WITNESS terms — the wall
  const comm = mandateCommitment(mandateSecretKey(), mandateCap(), mandateCategory());
  assert(comm == m.actionCommitment, "mandate commitment mismatch");

  // terms checks: amount within private cap, category match
  assert(amount <= mandateCap(), "amount exceeds mandate cap");
  assert(actionCategory == mandateCategory(), "action category not allowed");

  // expiry is a public term, enforced by ledger block time
  assert(!(blockTimeGte(m.expiry)), "mandate expired");

  uses.insert(id, disclose((uses.lookup(id) + 1) as Uint<64>));
}

/**
 * Principal revokes: only the revoke-secret holder, permanent. A revoked
 * mandate can never authorize again (one-way flag, like credential
 * revocation).
 */
export circuit revokeMandate(mandateId: Uint<64>): [] {
  const id = disclose(mandateId);
  assert(mandates.member(id), "mandate not found");
  const m = mandates.lookup(id);
  const caller = revokeCommitment(revokeSecretKey());
  assert(caller == m.revokeCommitment, "only the principal can revoke");
  mandates.insert(id, Mandate {
    actionCommitment: m.actionCommitment,
    revokeCommitment: m.revokeCommitment,
    expiry: m.expiry,
    revoked: true
  });
}

/** Public read helpers (hub polls via indexer). */
export circuit isRevoked(mandateId: Uint<64>): Boolean {
  const id = disclose(mandateId);
  assert(mandates.member(id), "mandate not found");
  return mandates.lookup(id).revoked;
}

export circuit useCount(mandateId: Uint<64>): Uint<64> {
  const id = disclose(mandateId);
  assert(mandates.member(id), "mandate not found");
  return uses.lookup(id);
}
