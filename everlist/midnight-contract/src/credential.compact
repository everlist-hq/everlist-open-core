/**
 * EverList Personhood Credential - hub-admitted issuer (M13 increment)
 *
 * Tier-2 identity for EverList: a credential contract proving "one verified
 * human" WITHOUT revealing who. The HUB is the pilot issuer (honest note:
 * no live third-party personhood issuer exists on Midnight yet - A0 research
 * docs/midnight-a0-toolchain.md; EverList admits holders itself until the
 * ecosystem has one, exactly like the operator-vouch it replaces, but now
 * with revocable on-chain commitments and ZK sign-in).
 *
 * Pattern: leaderboard/ownerHash (hub-admitted issuer)
 *   - initializeIssuer(): the FIRST caller becomes the issuer; its commitment
 *     (persistentHash of a witness secret, prefix-separated) is stored ONCE
 *     at map key 0. Nobody can ever take over or re-initialize.
 *   - issueCredential(): ONLY the issuer (witness -> hash -> assert, same
 *     wall as the escrow role checks) admits a holder commitment.
 *   - revokeCredential(): ONLY the issuer revokes (the revocation registry).
 *   - proveHolder(): the holder's ZK SIGN-IN ACT - a successful call proves
 *     knowledge of the secret behind an ADMITTED, NON-REVOKED commitment.
 *     The hub (M14) accepts this proof as verified_by: midnight-zk.
 *   - isRevoked(): public read helper for hub-side checks (query circuit).
 *
 * Privacy: holder secrets NEVER leave the holder's machine (witness); only
 * commitments touch the ledger. Disclosure discipline identical to escrow.
 *
 * Language: Compact 0.26 (compiler 0.34.0)
 */

pragma language_version 0.26;

import CompactStandardLibrary;

export ledger issuer: Map<Uint<64>, Bytes<32>>;   // key 0 = issuer commitment (singleton)
export ledger holders: Map<Uint<64>, Bytes<32>>;  // credential id -> holder commitment
export ledger revoked: Map<Uint<64>, Boolean>;    // revocation registry (same ids)
export ledger nextId: Counter;

witness issuerSecretKey(): Bytes<32>;
witness holderSecretKey(): Bytes<32>;

/** Issuer commitment (prefix-separated domain). sk never leaves the hub. */
export circuit issuerCommitment(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "everlist:issuer:"), sk]);
}

/** Holder commitment. sk never leaves the holder's machine/wallet. */
export circuit holderCommitment(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "everlist:holder:"), sk]);
}

/**
 * First caller becomes THE issuer. Singleton at key 0: a second call (by
 * anyone, including an attacker) is rejected forever.
 */
export circuit initializeIssuer(): [] {
  assert(!issuer.member(0), "issuer already initialized");
  issuer.insert(0, disclose(issuerCommitment(issuerSecretKey())));
}

/**
 * Issuer admits a holder: stores the holder's commitment under a fresh id.
 * Issuer-walled (witness -> hash -> assert). Returns the credential id.
 */
export circuit issueCredential(holderComm: Bytes<32>): Uint<64> {
  assert(issuer.member(0), "issuer not initialized");
  const caller = issuerCommitment(issuerSecretKey());
  assert(caller == issuer.lookup(0), "only the issuer can admit holders");

  nextId.increment(1);
  const id = disclose(nextId.read() as Uint<64>);
  holders.insert(id, disclose(holderComm));
  revoked.insert(id, false);
  return id;
}

/**
 * Issuer revokes a credential (compromise, duplicate-human detection, ...).
 * Issuer-walled. Revocation is one-way: a revoked id can never return.
 */
export circuit revokeCredential(credId: Uint<64>): [] {
  const id = disclose(credId);
  assert(issuer.member(0), "issuer not initialized");
  const caller = issuerCommitment(issuerSecretKey());
  assert(caller == issuer.lookup(0), "only the issuer can revoke");
  assert(holders.member(id), "credential not found");
  revoked.insert(id, true);
}

/**
 * The Tier-2 SIGN-IN PROOF (M14 consumes this): the holder demonstrates, in
 * ZK, knowledge of the secret behind an ADMITTED and NON-REVOKED commitment.
 * Any failure (unknown id, wrong secret, revoked) rejects - the call either
 * succeeds as a proof or reveals nothing.
 */
export circuit proveHolder(credId: Uint<64>): [] {
  const id = disclose(credId);
  assert(holders.member(id), "credential not found");
  const mine = holderCommitment(holderSecretKey());
  assert(mine == holders.lookup(id), "holder commitment mismatch");
  assert(!revoked.lookup(id), "credential revoked");
}

/** Public read helper: is this credential revoked? (hub polls via indexer) */
export circuit isRevoked(credId: Uint<64>): Boolean {
  const id = disclose(credId);
  assert(holders.member(id), "credential not found");
  return revoked.lookup(id);
}
